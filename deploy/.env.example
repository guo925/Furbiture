# ============================================================
# 生产环境变量模板
# 使用方式：cp deploy/.env.example deploy/.env 后填入真实值
# 注意：deploy/.env 已被 .gitignore 忽略，切勿提交真实密钥
# ============================================================

# 对外访问端口（Nginx）
HTTP_PORT=8080

# ---------- 数据库 ----------
DB_NAME=furniture_db
# 务必改为强密码，不要沿用开发环境的 123456
DB_PASSWORD=change-me-to-a-strong-db-password

# ---------- Redis ----------
REDIS_PASSWORD=change-me-to-a-strong-redis-password

# ---------- JWT ----------
# 必须为 32 字节以上的随机字符串，生成方式：
#   openssl rand -base64 48
# 该值一旦泄露，攻击者可伪造任意用户的登录凭证
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# ---------- 跨域 ----------
# 生产环境填真实域名，多个用英文逗号分隔；留空表示不允许跨域
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ---------- 订单超时 ----------
ORDER_TIMEOUT_MINUTES=30

# ---------- 阿里云 OSS（可选，不配置则使用本地磁盘存储）----------
# OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# OSS_BUCKET_NAME=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
